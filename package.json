      "@sairidev/baileys-new": "file:./packages/sairidev-baileys-new-0.3.21.tgz",
      "cheerio": "^1.0.0",
      "file-type": "21.3.4",
      "qrcode": "~1.5.4",
      "pino": "^9.6.0",
      "undici": "^7.4.0",
      "yt-search": "^2.13.1"
   },
   "packageManager": "yarn@1.22.22"
