# ==========================================
# DENIA-MD PC AGENT - ENVIRONMENT VARIABLES
# ==========================================
# Port PC Agent berjalan pada PC tempatan (default: 4000)
AGENT_PORT=4000

# Token keselamatan rahsia untuk mengesahkan panggilan daripada Web Dashboard
# Wajib sepadan dengan nilai PC_AGENT_TOKEN pada web dashboard
AGENT_SECRET_TOKEN=jana_token_rahsia_panjang_di_sini

# Had sambungan host tempatan (127.0.0.1 untuk perlindungan, jangan dedahkan ke 0.0.0.0 tanpa firewall)
AGENT_HOST=127.0.0.1

