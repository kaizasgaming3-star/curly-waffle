# Recommended dynamic backend configuration: a public GitHub Gist raw JSON URL.
# The Gist must contain only non-secret routing configuration; never store tokens,
# Pterodactyl credentials, WhatsApp sessions, or pairing codes in it.
UMI_CONFIG_GIST_URL=https://gist.githubusercontent.com/OWNER/GIST_ID/raw/umi-server-config.json

# Fallback only when no Gist is configured. Must be an HTTPS origin.
# UMI_API_ORIGIN=https://api.example.com

# Private hourly backup service. Values are production secrets and must be set
# only in Vercel and the external scheduler, never committed or put in the Gist.
# BACKUP_CRON_SECRET=replace-with-a-random-secret
# BOT_BACKUP_EXPORT_SECRET=replace-with-a-different-random-secret
# BLOB_READ_WRITE_TOKEN=is-added-by-private-vercel-blob-store


# ---------------------------------------------------------------- ekosistem
# Rahasia bersama untuk memanggil bot /api/platform-system/* dari /api/ecosystem.
# Nilai harus SAMA dengan PLATFORM_API_SECRET di bot/.env. Hanya di Vercel.
# PLATFORM_API_SECRET=replace-with-the-same-value-as-bot
